# ---------------------------------------------------------------------------
# Pochi Desayunos · variables de entorno
# Copia este archivo como `.env.local` y completa los valores pendientes.
# Ninguno de estos datos se rellena de ejemplo: si falta, el sitio lo indica
# en el README y no publica información inventada.
# ---------------------------------------------------------------------------

# Número de WhatsApp del negocio, solo dígitos con código de país.
# Ejemplo de formato (NO es un número real): 573001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Dominio definitivo del sitio, sin barra final. Requerido antes de publicar:
# alimenta la URL canónica, Open Graph, el sitemap, robots.txt y los datos
# estructurados. Ejemplo de formato: https://www.tusitio.com
NEXT_PUBLIC_SITE_URL=

# Etiqueta de verificación de Google Search Console (opcional).
# Se obtiene en Search Console > Configuración > Verificación de propiedad.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
